<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Message — Board</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --bg: #0e0e0e;
        --surface: #161616;
        --border: #2a2a2a;
        --accent: #c8f04d;
        --text: #e8e8e0;
        --muted: #666;
        --serif: "DM Serif Display", Georgia, serif;
        --sans: "DM Sans", system-ui, sans-serif;
      }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        font-weight: 300;
        min-height: 100vh;
      }

      /* ── NAV ── */
      nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 3rem;
        border-bottom: 1px solid var(--border);
        background: rgba(14, 14, 14, 0.85);
        backdrop-filter: blur(12px);
      }

      nav .logo {
        font-family: var(--serif);
        font-size: 1.1rem;
        color: var(--accent);
        text-decoration: none;
      }

      nav a.back {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition: color 0.2s;
      }

      nav a.back:hover {
        color: var(--text);
      }

      /* ── LAYOUT ── */
      main {
        max-width: 560px;
        margin: 0 auto;
        padding: 8rem 2rem 4rem;
      }

      .page-title {
        font-family: var(--serif);
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        margin-bottom: 0.5rem;
      }

      .page-title em {
        font-style: italic;
        color: var(--accent);
      }

      .subtitle {
        color: var(--muted);
        font-size: 0.88rem;
        margin-bottom: 3rem;
      }

      /* ── FORM ── */
      form {
        display: flex;
        flex-direction: column;
        gap: 1.6rem;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      label {
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
      }

      input,
      textarea {
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--text);
        font-family: var(--sans);
        font-size: 0.95rem;
        font-weight: 300;
        padding: 0.9rem 1rem;
        outline: none;
        width: 100%;
        transition: border-color 0.2s;
      }

      input:focus,
      textarea:focus {
        border-color: var(--accent);
      }

      input::placeholder,
      textarea::placeholder {
        color: var(--muted);
        font-size: 0.85rem;
      }

      textarea {
        height: 160px;
        resize: none;
      }

      .form-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      button[type="submit"] {
        background: var(--accent);
        color: #0e0e0e;
        border: none;
        padding: 0.9rem 2.2rem;
        font-family: var(--sans);
        font-size: 0.82rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
        transition:
          opacity 0.2s,
          transform 0.2s;
      }

      button[type="submit"]:hover {
        opacity: 0.85;
        transform: translateY(-2px);
      }

      .cancel {
        color: var(--muted);
        font-size: 0.8rem;
        text-decoration: none;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        transition: color 0.2s;
      }

      .cancel:hover {
        color: var(--text);
      }

      @media (max-width: 540px) {
        nav {
          padding: 1rem 1.25rem;
        }
        main {
          padding-top: 7rem;
        }
      }
    </style>
  </head>
  <body>
    <%- include('nav') %>
    <main>
      <h1 class="page-title">Post a<br /><em>message.</em></h1>
      <p class="subtitle">Say something. Anything.</p>

      <form action="/new" method="POST">
        <div class="field">
          <label for="user">Name</label>
          <input
            type="text"
            id="user"
            name="user"
            placeholder="Your name (or leave blank for Anonymous)"
            maxlength="60"
          />
        </div>
        <div class="field">
          <label for="text">Message</label>
          <textarea
            id="text"
            name="text"
            placeholder="What's on your mind?"
            maxlength="500"
            required
          ></textarea>
        </div>
        <div class="form-footer">
          <button type="submit">Post message</button>
          <a class="cancel" href="/">Cancel</a>
        </div>
      </form>
    </main>
  </body>
</html>
